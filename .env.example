# Illustrative production environment. Replace every registry.example.invalid
# value with a reviewed exact tag or immutable digest before deployment.
SENTINEL_IMAGE=registry.example.invalid/home-sentinel:REPLACE_ME
MOSQUITTO_IMAGE=registry.example.invalid/mosquitto:REPLACE_ME
HOMEASSISTANT_IMAGE=registry.example.invalid/homeassistant:REPLACE_ME
FRIGATE_IMAGE=registry.example.invalid/frigate:REPLACE_ME
OLLAMA_IMAGE=registry.example.invalid/ollama:REPLACE_ME

# UI and Home Assistant may be bound to localhost when accessed through VPN/
# reverse proxy, or to an explicitly trusted LAN address.
SENTINEL_BIND_IP=127.0.0.1
HOMEASSISTANT_BIND_IP=127.0.0.1

# Internal go2rtc API. Keep port 1984 unexposed; Sentinel proxies managed streams.
SENTINEL_GO2RTC_URL=http://frigate:1984

# WebRTC media is separate from the private go2rtc HTTP API. Bind 8555 only on
# an address reachable by trusted LAN/VPN clients and advertise the same address.
FRIGATE_WEBRTC_BIND_IP=192.168.1.10
FRIGATE_WEBRTC_CANDIDATES=192.168.1.10:8555

SENTINEL_CONTROL_SUBNET=172.30.250.0/24
SENTINEL_APP_EGRESS_SUBNET=172.30.251.0/24
SENTINEL_CAMERA_EGRESS_SUBNET=172.30.252.0/24

# Compose secret source files. chmod 600 and keep them outside the repository.
SENTINEL_MQTT_PASSWORD_FILE=/opt/home-sentinel/secrets/sentinel-mqtt-password
FRIGATE_MQTT_PASSWORD_FILE=/opt/home-sentinel/secrets/frigate-mqtt-password
HOMEASSISTANT_MQTT_PASSWORD_FILE=/opt/home-sentinel/secrets/homeassistant-mqtt-password
