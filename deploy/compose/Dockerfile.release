# Release-only image. Both bases are mandatory immutable refs, for example
# golang:1.26.6-bookworm@sha256:<digest> and debian:bookworm-slim@sha256:<digest>.
ARG GO_BUILD_IMAGE
ARG RUNTIME_IMAGE
FROM ${GO_BUILD_IMAGE} AS build
ARG SENTINEL_VERSION
ARG GIT_COMMIT
ARG BUILD_TIME
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download && go mod verify
COPY . .
RUN CGO_ENABLED=0 go build -trimpath \
    -ldflags="-s -w -X github.com/homesentinel/home-sentinel/internal/buildinfo.Version=${SENTINEL_VERSION} -X github.com/homesentinel/home-sentinel/internal/buildinfo.Commit=${GIT_COMMIT} -X github.com/homesentinel/home-sentinel/internal/buildinfo.BuildTime=${BUILD_TIME}" \
    -o /out/sentinel ./cmd/sentinel

FROM ${RUNTIME_IMAGE}
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates ffmpeg smartmontools v4l-utils restic \
 && rm -rf /var/lib/apt/lists/*
RUN useradd --system --uid 10001 --home /nonexistent --shell /usr/sbin/nologin sentinel \
 && mkdir -p /var/lib/home-sentinel \
 && chown sentinel:sentinel /var/lib/home-sentinel
COPY --from=build /out/sentinel /usr/local/bin/sentinel
USER sentinel
WORKDIR /var/lib/home-sentinel
ENTRYPOINT ["/usr/local/bin/sentinel"]
CMD ["serve"]
